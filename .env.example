# DokanAI Environment Variables
# Copy this file to .env and fill in your values

# 1. AI Provider Priority Selection ('groq' or 'gemini')
# If 'groq' (default): Groq Keys (1->2->3) -> Fallback to Gemini Keys (1->2->3)
# If 'gemini': Gemini Keys (1->2->3) -> Fallback to Groq Keys (1->2->3)
AI_PROVIDER=groq

# Groq API Keys (https://console.groq.com/) - Up to 3 keys for failover rotation
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Keys (https://aistudio.google.com/) - Up to 3 keys for failover rotation
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Configuration (Free Postgres from: https://supabase.com/)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# 3. Telegram Bot Notifications (Optional - 1-Click order alerts for merchants)
# Create a bot via @BotFather on Telegram and paste token and username here:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
