# DokanAI Environment Variables
# Copy this file to .env and fill in your values

# 1. AI Provider Selection ('gemini' or 'groq')
AI_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (Fast free inference from https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Supabase Configuration (Free Postgres from: https://supabase.com/)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
