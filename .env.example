# DokanAI Environment Variables
# Copy this file to .env and fill in your values

# 1. Google Gemini API Key (Get free key from: https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Supabase Configuration (Free Postgres from: https://supabase.com/)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
